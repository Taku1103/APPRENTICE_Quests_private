' alt+DでER図表示

@startuml shortcut_quiz

' hide the spot
hide circle

' avoid problems with angled crows feet
skinparam linetype ortho


entity "ver 0.5.0" {

}

entity "users" {
    *id <generated> : Integer
    --
    *id_on_twitch: String
    *login_name : String
    *display_name: String
    *profile_image_url: String
    *user_created_at: String

    *created_at : datetime
    *update_at : datetime
}


entity "playlists" {
    *id <generated> : Integer
    --
    *user_id <FK>
    *name : String
    *favorite_count : Integer
    *published :Boolean

    *created_at : Date
    *update_at : Date
}


entity "clips" {
    *id <generated> : Integer(LIB上管理ID)
    --
    *id_on_twitch : String (Twitch上管理ID)
    *url : String
    *embed_url : String
    *broadcaster_id : String
    *broadcaster_name : String
    *creator_id : String
    *creator_name : String
    *video_id : String
    *game_id : String
    *language : String
    *title : String
    *view_count : Integer
    *clip_created_at : String
    *thumbnail_url: String
    *duration : float
    *vod_offset : Integer
    *is_featured : Boolean
    *game_title : String (別でAPI叩く必要有)

    *created_at : datetime
    *update_at : datetime
}


entity  "playlist_clips" {
    *id <generated> : Integer
    --
    *playlist_id <FK>
    *clip_id <FK>
    --
    *order_index : Integer

    *created_at : datetime
    *update_at : datetime
}
entity "user_favorite_playlists" {
    *id <generated> : Integer
    --
    *user_id <FK>
    *playlist_id <FK>
    --
    *order_index : Integer

    *created_at : datetime
    *update_at : datetime
}

entity "daily_highlight_playlists" {
    *id <generated> : Integer
    --
    *playlist_id <FK>
    *start_date : Date

    *created_at : datetime
    *update_at : datetime
}
entity "weekly_highlight_playlists" {
    *id <generated> : Integer
    --
    *playlist_id <FK>
    *start_date : Date
    *end_date : Date

    *created_at : datetime
    *update_at : datetime
}
entity "monthly_highlight_playlists" {
    *id <generated> : Integer
    --
    *playlist_id <FK>
    *start_date : Date
    *end_date : Date

    *created_at : datetime
    *update_at : datetime
}



users||--|{playlists
playlists||--|{playlist_clips
playlist_clips}|--||clips
users||--|{user_favorite_playlists
user_favorite_playlists}|--||playlists

daily_highlight_playlists}|--||playlists
weekly_highlight_playlists}|--||playlists
monthly_highlight_playlists}|--||playlists






@enduml


